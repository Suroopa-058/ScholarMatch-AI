# Comma-separated origins allowed to use the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact SentenceTransformer model identifier/path used during training.
SBERT_MODEL_PATH=sentence-transformers/all-MiniLM-L6-v2
TOP_K=5
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
